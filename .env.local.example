# Copy this file to .env.local for local dev, or set these in
# Vercel Project Settings -> Environment Variables for deployment.

# Gemini API key (free tier). Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Single-user login credentials for the /login page.
# Pick your own values here -- this is a simple gate, not a full user system.
APP_USERNAME=admin
APP_PASSWORD=change-this-password

# Random secret used to sign session cookies. Any long random string works.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=replace-with-a-long-random-string
